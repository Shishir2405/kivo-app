{
  "expo": {
    "name": "Kivo",
    "slug": "kivo",
    "version": "1.0.0",
    "scheme": "kivo",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kivo.app"
    },
    "android": {
      "package": "com.kivo.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F7F3ED",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F3ED",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#181511",
            "image": "./assets/splash-icon.png",
            "resizeMode": "contain"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/favicon.png",
          "color": "#C46A3D"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1a98afe6-8f8b-4bfa-b101-54bab37d4bd3"
      }
    },
    "owner": "kkkkkwwwwwa"
  }
}
